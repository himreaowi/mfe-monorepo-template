import { useEffect, useState, type ReactNode } from 'react';
import { useAuth } from '@org/auth';
import { Spinner } from '@org/ui';
import type { SignInMode } from '@/core/constants/signIn';
import { SignedOutLayout } from '@/layouts/ShellLayout/ShellLayout';
import { LandingPage } from '@/pages/LandingPage/LandingPage';

export type SignInGateProps = {
  /** `SIGN_IN_REQUIRED` (src/core/constants/signIn.ts). `false`: renders `children` as is. */
  required: boolean;
  /** `SIGN_IN_MODE`: `landing` page, or `redirect` straight to the sign-in page. */
  mode: SignInMode;
  /** The portal (layout, nav, routes, remotes): rendered only for a signed-in user. */
  children: ReactNode;
};

/**
 * Sign-in for the whole portal. Until the session check says "signed in", `children` are not
 * rendered: no nav, no route, no `<RemoteApp>`, so no remote's mf-manifest.json or code is
 * downloaded (main.tsx only registers the remotes' URLs, nothing is fetched before a remote is
 * rendered). Signed out, `SignedOutLayout` (brand-only header) shows:
 *
 * - while the session is checked or the browser goes to the sign-in page: a spinner;
 * - `landing`: LandingPage;
 * - `redirect`: `signIn()` right away (back to the current address). Falls back to the
 *   LandingPage when the BFF is unreachable (no redirect loop), after a sign-out in this page
 *   (no bounce back into single sign-on) and when sign-in is not configured.
 *
 * Sign-in not configured (`status: 'disabled'`): fails closed like RequireAuth, the portal
 * stays hidden and the landing page says sign-in is unavailable.
 */
export function SignInGate({ required, mode, children }: SignInGateProps) {
  const auth = useAuth();
  // signed in at some point in this page: a later sign-out shows the landing page, even in
  // redirect mode
  const [hadSession, setHadSession] = useState(false);
  if (auth.status === 'signedIn' && !hadSession) setHadSession(true);
  const shouldRedirect =
    required &&
    mode === 'redirect' &&
    auth.status === 'signedOut' &&
    !auth.error &&
    !hadSession;

  useEffect(() => {
    if (shouldRedirect) void auth.signIn();
  }, [shouldRedirect, auth]);

  if (!required || auth.status === 'signedIn') return <>{children}</>;
  const busy =
    auth.status === 'loading' ||
    auth.status === 'redirecting' ||
    shouldRedirect;
  return (
    <SignedOutLayout>
      {busy ? (
        <Spinner
          size="lg"
          label={
            auth.status === 'loading'
              ? 'Checking sign-in…'
              : 'Redirecting to sign-in…'
          }
          data-testid="sign-in-gate-busy"
        />
      ) : (
        <LandingPage />
      )}
    </SignedOutLayout>
  );
}
